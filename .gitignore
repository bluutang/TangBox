# NostalgiaBox
# Each install has its own config (the installer creates it from
# config.example.yaml). Keep personal configs out of the repo.
config.yaml
# Generated filler clips (created by `nostalgiabox --generate-assets`).
nostalgiabox/assets/*.mp4

# OS cruft
.DS_Store
Thumbs.db

# Local demo episodes generated for Mac preview (12MB of ffmpeg test patterns).
demo-media/

# Staging check config - absolute paths that only exist on this Mac.
config.staging.yaml

# Demo commercial clips for Mac preview (ffmpeg test patterns).
demo-commercials/
